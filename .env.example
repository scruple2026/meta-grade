# Vercel Project Settings -> Environment Variables
# Local testing with `vercel dev` can use the same names in `.env.local`.

# Required. Keep this server-side only; never put it in frontend JS.
OPENAI_API_KEY=sk-your-key-here

# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional. Base URL only; api/battle.js appends /responses first and can fall
# back to /chat/completions for compatible providers that reject /responses.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Best-effort in-memory rate limit per serverless instance.
BATTLE_RATE_LIMIT_WINDOW_MS=60000
BATTLE_RATE_LIMIT_MAX=12

# Optional. Comma/newline separated access codes. Leave empty to allow any visitor
# to call /api/battle when OPENAI_API_KEY is configured.
BATTLE_ACCESS_CODES=

# Optional. Best-effort daily budget per serverless instance and UTC day.
# Set either value to 0 to disable that budget.
BATTLE_DAILY_REQUEST_LIMIT=0
BATTLE_DAILY_TOKEN_LIMIT=0

# Optional. silent/error/info/debug. Logs request IDs, status, timing and usage
# summaries only; prompts, outputs, access codes and API keys are not logged.
BATTLE_LOG_LEVEL=error

# Optional. Set to 1/true/yes/on to keep the site public while disabling LLM calls.
BATTLE_API_DISABLED=0
