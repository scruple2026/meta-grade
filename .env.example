# Vercel Project Settings -> Environment Variables
# Local testing with `vercel dev` can use the same names in `.env.local`.

# Required. Keep this server-side only; never put it in frontend JS.
OPENAI_API_KEY=sk-your-key-here

# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional. Base URL only; api/battle.js appends /responses first and can fall
# back to /chat/completions for compatible providers that reject /responses.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Best-effort in-memory rate limit per serverless instance.
BATTLE_RATE_LIMIT_WINDOW_MS=60000
BATTLE_RATE_LIMIT_MAX=12
