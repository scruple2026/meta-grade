# Vercel Project Settings -> Environment Variables
# Local testing with `vercel dev` can use the same names in `.env.local`.

# Required. Keep this server-side only; never put it in frontend JS.
OPENAI_API_KEY=sk-your-key-here

# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional. Base URL only; api/battle.js appends /responses.
# The provider must support the OpenAI Responses API shape used by this project.
OPENAI_BASE_URL=https://api.openai.com/v1
